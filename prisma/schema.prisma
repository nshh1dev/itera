generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Level {
  INITIATION
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SubmissionStatus {
  RUNNING
  PASSED
  FAILED
  ERROR
}

// Cómo se ejecuta y se corrige una versión. FUNCTION envuelve solve(data) y
// compara el valor devuelto; PROGRAM ejecuta el archivo como programa completo
// y compara lo que imprime por la salida estándar.
enum RuntimeMode {
  FUNCTION
  PROGRAM
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  disabledAt    DateTime?
  onboardingStep Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  preference    UserPreference?
  learningProfiles LearningProfile[]
  diagnostics Diagnostic[]
  drafts        Draft[]
  submissions   Submission[]
  progress      Progress[]
  helpUsage     HelpUsage[]
  auditLogs     AuditLog[]
  practiceContexts PracticeContext[]
  accountActionLimit AccountActionLimit?
}

model AccountActionLimit {
  userId    String   @id
  attempts  Int      @default(0)
  startedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                     String    @id
  accountId              String
  providerId             String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model UserPreference {
  userId   String @id
  language String @default("python")
  level    Level  @default(INITIATION)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// La declaración no es progreso ni una certificación de conocimientos.
model LearningProfile {
  userId String
  language String
  declaredLevel Level
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, language])
}

model Diagnostic {
  id String @id @default(cuid())
  userId String
  language String
  declaredLevel Level
  rulesVersion Int @default(1)
  createdAt DateTime @default(now())
  finishedAt DateTime?
  suggestedLevel Level?
  reason String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items DiagnosticItem[]
  @@index([userId, language, createdAt])
}

model DiagnosticItem {
  id String @id @default(cuid())
  diagnosticId String
  variantId String
  position Int
  code String
  revision Int @default(1)
  diagnostic Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  variant ExerciseVariant @relation(fields: [variantId], references: [id])
  submissions Submission[]
  @@unique([diagnosticId, position])
}

model Exercise {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String
  order       Int
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  versions    ExerciseVersion[]
  progress    Progress[]
  pathItems   LearningPathItem[]
  helpUsage   HelpUsage[]
  practiceContexts PracticeContext[]
}

model ExerciseVersion {
  id           String   @id @default(cuid())
  exerciseId   String
  number       Int      @default(1)
  published    Boolean  @default(false)
  title        String
  description  String
  statement    String
  objective    String   @default("")
  prerequisites String[] @default([])
  practiceGoals String[] @default([])
  prerequisiteSlugs String[] @default([])
  activityType String @default("PRACTICE")
  runtimeMode  RuntimeMode @default(FUNCTION)
  conceptRule  String   @default("")
  complexity   String   @default("")
  commonErrors String[] @default([])
  constraints  String[]
  hints        String[]
  level        Level
  minutes      Int
  createdAt    DateTime @default(now())
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  variants     ExerciseVariant[]
  @@unique([exerciseId, number])
}

model ExerciseVariant {
  id          String @id @default(cuid())
  versionId   String
  language    String
  starter     String
  solution    String
  explanation String
  statement   String @default("")
  typeContract String @default("")
  project     Json?
  solutionFiles Json?
  version     ExerciseVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  tests       TestCase[]
  drafts      Draft[]
  submissions Submission[]
  diagnosticItems DiagnosticItem[]
  @@unique([versionId, language])
}

model TestCase {
  id        String @id @default(cuid())
  variantId String
  input     Json
  expected  Json
  expectedFiles Json?
  explanation String @default("")
  visible   Boolean @default(false)
  order     Int
  variant   ExerciseVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@unique([variantId, order])
}

model Draft {
  id        String @id @default(cuid())
  userId    String
  variantId String
  code      String
  files     Json?
  revision  Int @default(1)
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ExerciseVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@unique([userId, variantId])
}

model Submission {
  id             String @id @default(cuid())
  userId         String
  variantId      String
  code           String
  files          Json?
  mode           String
  diagnosticItemId String?
  diagnosticItem DiagnosticItem? @relation(fields: [diagnosticItemId], references: [id], onDelete: Cascade)
  status         SubmissionStatus @default(RUNNING)
  idempotencyKey String
  passedCount    Int @default(0)
  totalCount     Int @default(0)
  results        Json?
  message        String?
  createdAt      DateTime @default(now())
  finishedAt     DateTime?
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant        ExerciseVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([diagnosticItemId, createdAt])
}

model Progress {
  id           String @id @default(cuid())
  userId       String
  exerciseId   String
  language     String
  firstPassedAt DateTime?
  lastAttemptAt DateTime @default(now())
  attempts     Int @default(0)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@unique([userId, exerciseId, language])
}

model HelpUsage {
  id         String @id @default(cuid())
  userId     String
  exerciseId String
  language   String
  kind       String
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@unique([userId, exerciseId, language, kind])
}

// Continuidad entre navegadores. Abrir un ejercicio no concede progreso.
model PracticeContext {
  userId     String
  exerciseId String
  language   String
  pathSlug   String?
  visitedAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@id([userId, exerciseId, language])
  @@index([userId, visitedAt])
}

model LearningPath {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  order       Int
  items       LearningPathItem[]
}

model LearningPathItem {
  id         String @id @default(cuid())
  pathId     String
  exerciseId String
  position   Int
  path       LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@unique([pathId, exerciseId])
  @@unique([pathId, position])
}

model AuditLog {
  id        String @id @default(cuid())
  userId    String
  action    String
  resource  String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id])
}
